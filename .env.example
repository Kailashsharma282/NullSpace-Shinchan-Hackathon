# NullSpace Environment Configuration

# Service Configuration
PROJECT_NAME="NullSpace"
VERSION="1.0.0"
API_V1_STR="/api"
DATABASE_URL="sqlite:///./nullspace.db"

# AI Inference Provider Layer (Optional)
# Options: "local_fallback", "gemini", "openai"
# Default: "local_fallback" (100% deterministic, zero API keys required)
AI_PROVIDER="local_fallback"
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Ingestion & SSRF Safety
MAX_RESPONSE_SIZE_BYTES=2097152
HTTP_TIMEOUT_SECONDS=10.0
MAX_REDIRECTS=3

# Temporal Reference Anchor
CURRENT_REFERENCE_YEAR=2026
STALE_YEAR_THRESHOLD=1

